@startuml architecture
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam roundCorner 10
skinparam ArrowColor #475569
skinparam ArrowThickness 1.5
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
skinparam rectangle {
  BackgroundColor<<rag>> #EEF2FF
  BorderColor<<rag>> #6366F1
  BackgroundColor<<stage>> #ECFDF5
  BorderColor<<stage>> #10B981
  BackgroundColor<<store>> #FFF7ED
  BorderColor<<store>> #F59E0B
  BackgroundColor<<ext>> #FDF2F8
  BorderColor<<ext>> #EC4899
  BackgroundColor<<ui>> #F0FDFA
  BorderColor<<ui>> #14B8A6
}
title docling-rag-poc — local document RAG (one GPU box, cloud LLM API)

legend top left
<&check> |= <b>INGEST</b> (once per document, via ① upload) |= <b>QUERY</b> (every question, via ① ask) |
| <b>②</b> Docling parses (GPU)      | <b>②</b> Qdrant hybrid search: dense + sparse, RRF-fused |
| <b>③</b> original kept in files    | <b>③</b> Qwen3 reranks top-50 → keep ≥ 0.3 |
| <b>④</b> chunk with page numbers   | <b>④</b> all below 0.3? → 🚫 refuse, LLM never called |
| <b>⑤</b> BGE-M3: dense + sparse   | <b>⑤</b> cloud LLM answers from surviving chunks |
| <b>⑥</b> upsert into Qdrant        | <b>⑥</b> answer + [doc, chunk, page] citations → UI |
endlegend

actor User as user

rectangle "rag service\n(FastAPI · one GPU process\ncompose service: rag)" <<rag>> {
  rectangle "Docling\nlayout-aware parse\n(GPU: RapidOCR + layout)" <<stage>> as docling
  rectangle "Chunker\n~800 chars, keeps\npage numbers" <<stage>> as chunker
  rectangle "BGE-M3 embedder\none pass → dense (1024d)\n+ sparse (lexical)" <<stage>> as embed
  rectangle "Qwen3-Reranker 0.6B\nscores top-50 candidates\nrefusal gate: all < 0.3 → refuse" <<stage>> as rerank
  database "files volume\noriginal PDFs kept for\nfile.pdf#page=N links" <<store>> as files
}

database "Qdrant 1.15\n(compose service: qdrant)\ndense + sparse vectors\nserver-side RRF fusion" <<store>> as qdrant

cloud "Cloud LLM API\nOpenAI / OpenRouter / z.ai /\nany OpenAI-compatible\n(only internet dependency)" <<ext>> as llm

rectangle "Web UI\n(served by rag service)\ningest · doc list · chat" <<ui>> as ui

user --> ui : <b>INGEST ①</b> upload file\n<b>QUERY ①</b> ask question
ui --> docling : <b>INGEST ①</b> POST /documents
docling --> files : <b>INGEST ②</b> keep original
docling --> chunker : <b>INGEST ③</b> page-provenant items
chunker --> embed : <b>INGEST ④</b> chunks + pages
embed --> qdrant : <b>INGEST ⑤⑥</b> embed → upsert\n(dense + sparse)

ui --> qdrant : <b>QUERY ①</b> POST /query
qdrant --> rerank : <b>QUERY ②</b> fused top-50 (RRF)
rerank --> llm : <b>QUERY ③④</b> top-k (≥ 0.3)
rerank --> ui : <b>QUERY ③</b> 🚫 refuse (nothing relevant)
llm --> ui : <b>QUERY ⑤</b> grounded answer\n<b>QUERY ⑥</b> [doc, chunk, page] citations
ui --> user : <b>QUERY ⑥</b> answer; citation click\nopens file.pdf#page=N
@enduml
