@startuml ingest-flow
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 13
skinparam roundCorner 10
skinparam ArrowColor #475569
skinparam ArrowThickness 1.5
skinparam node {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
skinparam rectangle {
  BackgroundColor<<rag>> #EEF2FF
  BorderColor<<rag>> #6366F1
  BackgroundColor<<stage>> #ECFDF5
  BorderColor<<stage>> #10B981
  BackgroundColor<<store>> #FFF7ED
  BorderColor<<store>> #F59E0B
  BackgroundColor<<ui>> #F0FDFA
  BorderColor<<ui>> #14B8A6
}
title INGEST flow — once per document (POST /documents)

actor User as user
rectangle "Web UI\n(served by rag service)" <<ui>> as ui

rectangle "rag service\n(one GPU process)" <<rag>> {
  rectangle "① Docling\nlayout-aware parse\n(GPU: RapidOCR + layout)\nOCR, reading order, tables\nitems know their page" <<stage>> as docling
  rectangle "③ Chunker\n~800-char chunks\ncarrying page numbers" <<stage>> as chunker
  rectangle "④ BGE-M3 embedder\none pass per chunk →\ndense (1024d) + sparse (lexical)" <<stage>> as embed
  database "② files volume\noriginal kept for\nfile.pdf#page=N citation links" <<store>> as files
}

database "⑤⑥ Qdrant\ndense + sparse vectors\n+ page payloads\n(one upsert per document)" <<store>> as qdrant

user --> ui : ① upload file\n(drag & drop)
ui --> docling : ① POST /documents
docling --> files : ② keep original
docling --> chunker : ③ page-provenant items
chunker --> embed : ④ chunks + pages
embed --> qdrant : ⑤ embed → ⑥ upsert\n(dense + sparse)

note bottom of qdrant
  After this, the document is queryable.
  Originals are NOT needed for queries —
  only for citation page links.
end note
@enduml
