# ============================================================
# docling-rag-poc environment
# Copy to .env, adjust, then: docker compose up --build
# ============================================================

# --- LLM (the ONLY outbound internet dependency) ---
# Get a key at https://platform.openai.com/api_keys
OPENAI_API_KEY=sk-...
# OpenAI-compatible alternatives (Groq, OpenRouter, vLLM...): set LLM_BASE_URL
# and put the provider key into LLM_API_KEY.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Ports (host side) ---
RAG_PORT=8000
QDRANT_PORT=6333

# --- Retrieval / models (defaults are sensible; rarely touched) ---
QDRANT_COLLECTION=docs
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
EMBED_DIM=1024
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_LIMIT=50

# --- Docling parse tuning (RTX A4000 Mobile 8GB tuned) ---
# Docling defaults are 4/4/4. With BGE-M3 (~1.1GB) + Qwen3-0.6B (~1.3GB)
# resident, ~5GB VRAM stay free; 32/32/4 fills it and roughly doubles
# parse throughput. If you hit CUDA OOM during ingestion, step down 32 -> 16 -> 8.
DOCLING_LAYOUT_BATCH_SIZE=32
DOCLING_OCR_BATCH_SIZE=32
DOCLING_TABLE_BATCH_SIZE=4
# auto = CUDA if visible; set to cpu to force CPU parsing
DOCLING_DEVICE=auto

# --- Generation ---
MAX_ANSWER_TOKENS=1024
LOG_LEVEL=INFO
