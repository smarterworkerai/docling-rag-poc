# ============================================================
# docling-rag-poc environment
# Copy to .env, adjust, then: docker compose up --build
# ============================================================

# --- LLM (the ONLY outbound internet dependency) ---
# Provider "openai" (default): key from https://platform.openai.com/api-keys
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Provider "openrouter": key from https://openrouter.ai/keys
# One key gives access to hundreds of models; set LLM_PROVIDER=openrouter and
# use the OpenRouter model name (prefixed, e.g. openai/gpt-4o-mini,
# anthropic/claude-sonnet-4, google/gemini-2.5-flash, ...).
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# LLM_MODEL=openai/gpt-4o-mini

# Any other OpenAI-compatible endpoint (Groq, vLLM, Ollama, ...):
# set LLM_PROVIDER=openai, LLM_BASE_URL and put the key into LLM_API_KEY.
#
# Provider "zai" (GLM Coding Plan): key from https://z.ai/manage-apikey/apikey-list
# Coding-plan keys only work against the coding endpoint; the service handles
# that routing automatically. Models depend on your plan, e.g. glm-4.7 / glm-5.3.
# LLM_PROVIDER=zai
# ZAI_API_KEY=...
# LLM_MODEL=glm-4.7
#
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Ports (host side) ---
RAG_PORT=8000
QDRANT_PORT=6333

# --- Retrieval / models (defaults are sensible; rarely touched) ---
QDRANT_COLLECTION=docs
EMBED_MODEL=BAAI/bge-m3
# GPU default: Qwen/Qwen3-Reranker-0.6B (yes/no-logit scoring).
# CPU-only overlay default: BAAI/bge-reranker-base (~110MB cross-encoder).
# Any cross-encoder (bge-reranker-*, mxbai-rerank-*) is auto-detected.
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# auto = CUDA if visible, else CPU; set cpu on weak machines
DEVICE=auto
EMBED_DIM=1024
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_LIMIT=50

# --- Docling parse tuning (RTX A4000 Mobile 8GB tuned) ---
# Docling defaults are 4/4/4. With BGE-M3 (~1.1GB) + Qwen3-0.6B (~1.3GB)
# resident, ~5GB VRAM stay free; 32/32/4 fills it and roughly doubles
# parse throughput. If you hit CUDA OOM during ingestion, step down 32 -> 16 -> 8.
DOCLING_LAYOUT_BATCH_SIZE=32
DOCLING_OCR_BATCH_SIZE=32
DOCLING_TABLE_BATCH_SIZE=4
# auto = CUDA if visible; set to cpu to force CPU parsing
DOCLING_DEVICE=auto

# --- Generation ---
MAX_ANSWER_TOKENS=1024
LOG_LEVEL=INFO
